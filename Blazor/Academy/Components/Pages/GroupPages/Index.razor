@page "/groups"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using Academy.Models
@implements IAsyncDisposable
@inject IDbContextFactory<AcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Groups</PageTitle>

<div class="controls">
    <h1>Группы</h1>
    <form action="/groups">
        <input type="search" name="titleFilter" value="@TitleFilter" placeholder="Название группы" />
        <input type="submit" value="Найти" class="btn btn-primary" />
        @if (!string.IsNullOrWhiteSpace(TitleFilter))
        {
            <a href="/groups" class="btn btn-secondary">Сбросить</a>
        }
    </form>
    <div>
        <label for="items-per-page">Строк на странице: </label>
        <select id="items-per-page" @bind="pagination.ItemsPerPage" class="form-control">
            <option value="5">5</option>
            <option value="10">10</option>
            <option value="20">20</option>
            <option value="50">50</option>
        </select>
    </div>
    <div>
        <a href="groups/create" class="btn btn-primary">Создать</a>
    </div>
</div>

<div class="table-container">
    <QuickGrid Class="table" Items="FilteredGroups" Pagination="pagination">
        <PropertyColumn Title="Группа"
                        Property="group => group.group_name"
                        Sortable="true"
                        IsDefaultSortColumn="true" />
        <PropertyColumn Title="Дата начала" Property="group => group.start_date" Sortable="true" />
        <PropertyColumn Title="Время начала" Property="group => group.start_time" Sortable="true" />
        <TemplateColumn Title="Учебные дни"
                        Context="group"
                        Sortable="true"
                        SortBy="daysSort">
            @(new Week((int)(group.learning_days ?? 0)))
        </TemplateColumn>
        <PropertyColumn Title="Направление"
                        Property="group => group.Direction.direction_name"
                        Sortable="true" />

        <TemplateColumn Title="Действия" Context="group">
@*             <a href="@($"groups/edit?group_id={group.group_id}")">Изменить</a> |
 *@            <a href="@($"groups/details?group_id={group.group_id}")">Details</a> |
            <a href="@($"groups/delete?group_id={group.group_id}")">Delete</a>
        </TemplateColumn>
    </QuickGrid>
</div>
<Paginator State="pagination" />

@code {
    private AcademyContext context = default!;

    [SupplyParameterFromQuery(Name = "titleFilter")]
    public string? TitleFilter { get; set; }

    GridSort<Group> daysSort = GridSort<Group>.ByAscending(g => g.learning_days);

    PaginationState pagination = new PaginationState { ItemsPerPage = 10 };

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync()
    {
        await context.DisposeAsync();
    }

    private IQueryable<Group> FilteredGroups =>
        context.Groups
            .Include(g => g.Direction)
            .Where(g =>
                string.IsNullOrWhiteSpace(TitleFilter) ||
                g.group_name.Contains(TitleFilter));
}
