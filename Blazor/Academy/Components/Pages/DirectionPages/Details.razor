@page "/directions/details"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using Academy.Models
@using Academy.Components.Pages.GroupPages
@inject IDbContextFactory<AcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Направление</PageTitle>

<h1>Направление</h1>

<div>
    @if (direction is null)
    {
        <p><em>Загрузка...</em></p>
    }
    else
    {
        <div class="details-header">
            <h2>@direction.direction_name</h2>
            <a href="@($"/directions/edit?direction_id={direction.direction_id}")" class="btn btn-primary">Изменить</a>
        </div>

        <h3>Группы направления: @direction.Groups.Count</h3>

        @if (direction.Groups.Count == 0)
        {
            <p><em>По этому направлению пока нет групп.</em></p>
        }
        else
        {
            <QuickGrid Class="table" Items="direction.Groups.AsQueryable()">
                <PropertyColumn Title="Группа"
                                Property="group => group.group_name"
                                Sortable="true"
                                IsDefaultSortColumn="true" />
                <PropertyColumn Title="Дата начала" Property="group => group.start_date" Sortable="true" />
                <PropertyColumn Title="Время начала" Property="group => group.start_time" Sortable="true" />
                <TemplateColumn Title="Учебные дни"
                                Context="group"
                                Sortable="true"
                                SortBy="daysSort">
                    @(new Week((int)(group.learning_days ?? 0)))
                </TemplateColumn>
                <TemplateColumn Title="Действия" Context="group">
                    <a href="@($"/groups/details?group_id={group.group_id}")">Просмотр</a>
                </TemplateColumn>
            </QuickGrid>
        }

        <div>
            <a href="/directions">Назад к списку</a>
        </div>
    }
</div>

@code {
    private Direction? direction;

    [SupplyParameterFromQuery]
    private int direction_id { get; set; }

    GridSort<Group> daysSort = GridSort<Group>.ByAscending(g => g.learning_days);

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        direction = await context.Directions.Include(d => d.Groups).FirstOrDefaultAsync(m => m.direction_id == direction_id);

        if (direction is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }
}
