@page "/directions"
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using Academy.Models
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject IDbContextFactory<AcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Index</PageTitle>

<h1>Направления</h1>

<div class="controls">
    <p>
        <a href="directions/create">Create New</a>
    </p>
</div>
<QuickGrid Class="table" Items="context.Directions.Include(d => d.Groups).ThenInclude(g => g.Students)">
    <PropertyColumn Sortable="true" Property="direction => direction.direction_name" />
    <PropertyColumn Sortable="true" Property="direction => direction.Groups.Count" Title="Groups count"/>
    <PropertyColumn Sortable="true" Property="direction => direction.Groups.Sum(g => g.Students.Count)" Title="Students count"/>

    <TemplateColumn Context="direction">
        <a href="@($"directions/details?direction_id={direction.direction_id}")">Details</a>
    </TemplateColumn>
</QuickGrid>

@code {
    private AcademyContext context = default!;

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
