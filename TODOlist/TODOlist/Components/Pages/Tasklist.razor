@page "/tasklist"
@rendermode InteractiveServer
@using Models;

<div class="">
	<h5>Всего:@tasklist.Count</h5>
	<h5>Выполнено:@tasklist.Where(task => task.DONE == true).ToArray().Length</h5>
	<h5>Осталось:@tasklist.Where(task => task.DONE == false).ToArray().Length</h5>
</div>
<hr />
<input type="text" @bind="description" />
<input type="button" value="Добавить" @onclick="AddTask" class="btn btn-primary" />
<hr />

<h3>Tasklist</h3>

<ul>
	@foreach(TODO item in tasklist)
	{
		<li>
			<input type="checkbox" id="@item.Description" @bind="@item.DONE"/>
			<label for="@item.Description">@item.Description</label>
		</li>
	}
</ul>

@code {
	//List<Models.TODO> tasklist = [];
	List<Models.TODO> tasklist = 
	[
		new TODO{Description = "Полить цветы"},
		new TODO{Description = "Покормить кота"},
		new TODO{Description = "Сделать домашку"}
	];
	string description = "";
	void AddTask()
	{
		TODO item = new TODO { Description = description };
		if (tasklist.Contains(item)) return;
		tasklist.Add(item);
		description = "";
	}
}
